# copy to .env
POSTGRES_USER=quantlab
POSTGRES_PASSWORD=quantlab
POSTGRES_DB=quantlab
QUANTLAB_DATABASE_URL=postgresql+psycopg://quantlab:quantlab@localhost:5432/quantlab
QUANTLAB_REDIS_URL=redis://localhost:6379/0
QUANTLAB_CORS_ORIGINS=http://localhost:3000
# observability (see README): Grafana admin login is admin / this password, local demo only
# GRAFANA_ADMIN_PASSWORD=admin
# /metrics ports of the processes without their own web server (0 turns the endpoint off)
# QUANTLAB_WORKER_METRICS_PORT=9101
# QUANTLAB_CONSUMER_METRICS_PORT=9102
# gateway metrics listen address (empty disables it)
# QUANTLAB_GATEWAY_METRICS_ADDR=:9100
# web/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:8000
