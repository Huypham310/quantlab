# copy to .env
POSTGRES_USER=quantlab
POSTGRES_PASSWORD=quantlab
POSTGRES_DB=quantlab
QUANTLAB_DATABASE_URL=postgresql+psycopg://quantlab:quantlab@localhost:5432/quantlab
QUANTLAB_REDIS_URL=redis://localhost:6379/0
QUANTLAB_CORS_ORIGINS=http://localhost:3000
# observability (see README): Grafana admin login is admin / this password, local demo only
# GRAFANA_ADMIN_PASSWORD=admin
# /metrics ports of the processes without their own web server (0 turns the endpoint off)
# QUANTLAB_WORKER_METRICS_PORT=9101
# QUANTLAB_CONSUMER_METRICS_PORT=9102
# gateway metrics listen address (empty disables it)
# QUANTLAB_GATEWAY_METRICS_ADDR=:9100
# web/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker compose (docker compose up -d --build) ---
# Compose builds the in-network URLs itself (redis://redis, timescaledb:5432), so the localhost
# URLs above only matter when the apps run on the host.
# Baked into the web bundle at build time: the API address as seen by the browser
# NEXT_PUBLIC_API_URL=http://localhost:8000
# set to ml to put LightGBM + torch (CPU) into the backend image, needed for train jobs
# BACKEND_EXTRAS=ml
# feed the paper broker from the live trade stream inside the API container
# QUANTLAB_PAPER_LIVE=1
# Prometheus config: observability/prometheus.host.yml when the apps run on the host
# PROMETHEUS_CONFIG=./observability/prometheus.yml
